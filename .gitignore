# ── 本地凭据与私有配置（绝不入库）──
ui_settings.json
config.yaml
config.*.local.yaml
*.local.json
.env

# ── 运行时产物（含真实工单/缺陷数据，属于私有业务数据）──
# 锚定到项目根目录，避免误伤 tests/fixtures/proposals/ 下的脱敏夹具
/proposals/
/artifacts/
/screenshots/
/team_runs/
/usage/
/chat_sessions/
/knowledge_base/
logs/
*.log

# ── 本地专用回归（不随仓库发布）──
# 这两个用例断言的是「读取窗口要不要落在私有前端仓的某个具体文件上」——
# 要读真仓里某个组件的源码、并断言窗口覆盖了它的某个 handler 实现。
# 把它脱敏成中性路径就没有意义了，所以只在你本机跑，公开仓的 tests/ 全部自包含。
/tests/check_locate_regression.py
/tests/check_locate_regression2.py
/tests/fixtures/proposals/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ── Node（前端静态资源无构建步骤，保险起见）──
node_modules/

# ── 工作区临时文件 ──
_tmp_*
*.tmp
.relay-test-repo/
.workbuddy/
.DS_Store
Thumbs.db
