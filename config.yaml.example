# ONES connection
ones:
  base_url: https://ones.your-company.com
  token: ${ONES_TOKEN}              # Personal Access Token
  project_uuid: ${ONES_PROJECT_UUID}

# AI 接入 —— 全部可配，支持中转站/自建网关/本地推理，不依赖厂商 SDK
ai:
  # 协议：anthropic（Messages）| openai（Chat Completions）| custom（自建/异构网关）
  provider: anthropic
  base_url: ${AI_BASE_URL}            # 留空用官方地址；中转站填自己的域名，如 https://relay.foo.com/v1
  model: claude-3-5-sonnet-latest     # 任意该端点支持的模型名，可点界面「拉取列表」
  api_key: ${ANTHROPIC_API_KEY}       # 留空即自动降级为 Mock 模式
  mock: false                         # true = 强制不调外网

  temperature: 1.0
  max_tokens: 4000
  top_p:                              # 留空则不传该字段
  timeout: 120
  proxy:                              # 例如 http://127.0.0.1:7890
  verify_ssl: true                    # 内网自签证书才关

  # 端点形状：base_url 与 endpoint 拼成完整请求地址
  endpoint: /v1/messages              # openai 协议下一般是 /chat/completions
  models_path: /v1/models             # 「拉取列表」按钮打的路径
  content_path: content.0.text        # 从响应 JSON 取正文的点号路径，数字=数组下标
                                      # openai 协议通常是 choices.0.message.content
                                      # 网关若把结果放在 data.reply，就填 data.reply
  max_tokens_field: max_tokens        # 部分新端点要求 max_completion_tokens
  system_role: system                 # 有的网关把 system 改名为 developer
  json_mode: false                    # 是否发 response_format:{type:json_object}

  # 鉴权：bearer | x-api-key | header | query | none
  auth_style: x-api-key
  auth_header:                        # header/query 模式下的字段名，如 X-Auth-Token

  extra_headers: {}                   # {"X-Tenant": "demo-tenant"}
  extra_body: {}                      # {"enable_thinking": false} 网关私有参数

# Target repo. branch is only checked, never auto-switched; leave "" to skip the check.
repo:
  path: ${REPO_PATH}                # absolute path, e.g. D:/code/your-repo
  branch: develop

# Verification gate — decides whether a proposal is safe to approve.
# Layer 1 (best): explicit commands. Layer 2: auto-detected from package.json.
# Layer 3 (worst): bracket/quote balance only, and the UI says so loudly.
gate:
  commands:
    - name: typecheck
      cmd: npm run type-check
    - name: lint
      cmd: npm run lint
    - name: test
      cmd: npm run test:unit -- --run
  # runner: pnpm        # optional prefix, e.g. "pnpm dlx" / "npx --no-install"
  degraded: true        # keep doing syntax-level checks even without commands

# Playwright page verification (needs a running dev server; reports "unreachable" honestly)
playwright:
  base_url: http://localhost:3000
  headless: true
  screenshot_dir: ./screenshots

# Agentic 修复循环：读代码 → 出补丁 → 沙箱真跑验收 → 读报错 → 自我修复，直到跑绿或认输。
# 关掉它（enabled: false）就退回旧的「一次成型」链路。
agent:
  enabled: true
  max_rounds: 8          # 一次「交补丁 + 拿真实验证」算一轮
  deadline_seconds: 360  # 墙钟预算；到点收口，绝不挂住整条流水线
  max_stall: 3           # 同一验证结果连续 N 次 → 判定不收敛，认输转人工（不再烧 token）
  sandbox: auto          # auto|worktree|copy —— 补丁只落进仓库外的临时副本
  sandbox_dir: ""        # 留空用系统临时目录；C 盘紧张就指到别的盘
  link_node_modules: true  # 把源仓 node_modules 链进沙箱，否则 type-check 类命令会因缺依赖假失败
  per_command_timeout: 240
  page_read: true        # 让模型看修复前截图 + console 报错（多模态视觉判读）
  # 复现环节：先写一个针对工单现象的用例，在**未修复**代码上跑红，再开始修。
  #   auto = 探测到可用跑器才做（vitest/jest/mocha → 单测；没有就退化成可执行断言脚本）
  #   on   = 必须做；off = 关掉
  repro: auto
  # 探测不准时自己指定复现命令（{file}  = 用例路径）。monorepo 常用：
  # repro_command: "npx vitest run --root packages/demo-app {file}"
  repro_command: ""
  # 复现用例跑红失败时允许重写几次（超过就放弃复现环节并如实记录）
  repro_max_rewrite: 2
  # 页面复验：第一次拿到绿之后，在**打了补丁的沙箱**里起一次 dev server，
  # 按工单的复现操作再拍一张图，让模型对着修复前/后两张图判「现象消失了没有」。
  #   auto = 探得到 dev 脚本才起；on = 必须起；off = 只要命令级证据
  sandbox_server: auto
  # 探不准就自己写（{port} 会被换成一个空闲端口）：
  # sandbox_server_command: "pnpm --filter demo-app dev --port {port}"
  sandbox_server_command: ""
  sandbox_server_cwd: ""            # monorepo 里子包相对仓库根的路径
  sandbox_server_ready_timeout: 90  # 等端口就绪的秒数；剩余预算不足会直接跳过
  sandbox_server_max_checks: 2    # 一条缺陷最多起几次服务复验（判读说没修好时，下一版要重新看一次）
  # 同类历史缺陷先例：注入几条到 prompt（0 = 关闭）。连被人工拒绝的改法一起给，
  # 免得模型反复端上你们已经否掉的方案。
  precedents: 3
  precedents_chars: 6000
  # 沙箱默认只放行构建/测试/检查类命令（npm/npx/node/tsc/eslint/vitest/git diff…），
  # 删除、外发、发布、改 git 状态的命令一律拒绝。这里可以追加正则（谨慎）。
  # command_allow:
  #   - "^(pnpm|make)\\b"

# Where proposals wait for a human. Nothing touches repo.path until you approve one.
proposals:
  output_dir: ./proposals

knowledge_base:
  output_dir: ./knowledge_base
